he years shown.","cites":["AAPL.gross.2026","AAPL.revenue.2026","AAPL.gross.2021","AAPL.revenue.2021","AAPL.gross.2015","AAPL.revenue.2015","AAPL.gross.2016","AAPL.revenue.2016","AAPL.gross.2017","AAPL.revenue.2017","AAPL.gross.2018","AAPL.revenue.2018","AAPL.gross.2019","AAPL.revenue.2019","AAPL.gross.2020","AAPL.revenue.2020","AAPL.gross.2022","AAPL.revenue.2022","AAPL.gross.2023","AAPL.revenue.2023","AAPL.gross.2024","AAPL.revenue.2024","AAPL.gross.2025","AAPL.revenue.2025"]},{"topic":"rd","text":"Research and development took 9.6% of revenue in FY2026 ($45.8 billion), against 6% in FY2021.","cites":["AAPL.rd.2026","AAPL.revenue.2026","AAPL.rd.2021","AAPL.revenue.2021"]},{"topic":"capex","text":"Capital spending was $9 billion in FY2026, 1.9% of revenue; in FY2021 it was $11.1 billion, 3%.","cites":["AAPL.capex.2026","AAPL.revenue.2026","AAPL.capex.2021","AAPL.revenue.2021"]},{"topic":"inventory","text":"Inventory at the end of FY2026 was $14.5 billion, about 22 days of cost of revenue.","cites":["AAPL.inventory.2026","AAPL.cost.2026"]},{"topic":"mix","text":"The largest segment in FY2026 was Americas: $198 billion, 41% of revenue.","cites":["AAPL.mix.segment.2026.0","AAPL.revenue.2026"]},{"topic":"mix","text":"The largest region in FY2026 was Other countries: $229 billion, 48% of revenue.","cites":["AAPL.mix.geography.2026.0","AAPL.revenue.2026"]},{"topic":"mix","text":"The largest product line or market in FY2026 was iPhone: $254 billion, 53% of revenue.","cites":["AAPL.mix.product.2026.0","AAPL.revenue.2026"]}]}}