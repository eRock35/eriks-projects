:"2023-02-27"},"0000882835-24-000008":{"c":"ROP","form":"10-K","filed":"2024-02-22"},"0000882835-25-000008":{"c":"ROP","form":"10-K","filed":"2025-02-24"},"0000882835-26-000009":{"c":"ROP","form":"10-K","filed":"2026-02-24"},"0000882835-25-000020":{"c":"ROP","form":"10-Q","filed":"2025-05-02"},"0000882835-25-000036":{"c":"ROP","form":"10-Q","filed":"2025-08-01"},"0000882835-25-000045":{"c":"ROP","form":"10-Q","filed":"2025-10-31"},"0000882835-26-000019":{"c":"ROP","form":"10-Q","filed":"2026-05-01"},"0000882835-26-000036":{"c":"ROP","form":"10-Q","filed":"2026-07-31"},"0000882835-26-000047":{"c":"ROP","form":"10-Q","filed":"2026-11-02"},"0000882835-24-000044":{"c":"ROP","form":"10-Q","filed":"2024-11-01"},"0001193125-26-145481":{"c":"ROP","form":"DEF 14A","filed":"2026-04-07"}},"finsights":{"ROP":[{"topic":"sbc","text":"Stock-based compensation was $166 million in FY2025, 2.1% of revenue, against 2.2% in FY2020.","cites":["ROP.sbc.2025","ROP.revenue.2025","ROP.sbc.2020","ROP.revenue.2020"]},{"topic":"returns","text":"In FY2025 the company paid $500 million to repurchase its own shares and $355 million in dividends: $855 million together (computed from two filed figures).","cites":["ROP.buybacks.2025","ROP.dividends.2025"]},{"topic":"quarter","text":"In the three months ended 2026-09-30 revenue was $2.2 billion, up 7.6% from $2 billion in the three months ended 2025-09-30.","cites":["ROP.d.revenue.2026-07-01.2026-09-30","ROP.d.revenue.2025-07-01.2025-09-30"]},{"topic":"ttm","text":"Over the four quarters to 2026-09-30 revenue added up to $8.4 billion (computed from five filed figures), operating income to $2.4 billion and net income to $2.6 billion.","cites":["ROP.d.revenue.2025-01-01.2025-12-31","ROP.d.revenue.2025-01-01.2025-09-30","ROP.d.revenue.2026-01-01.2026-03-31","ROP.d.revenue.2026-04-01.2026-06-30","ROP.d.revenue.2026-07-01.2026-09-30","ROP.d.opinc.2025-01-01.2025-12-31","ROP.d.opinc.2025-01-01.2025-09-30","ROP.d.opinc.2026-01-01.2026-03-31","ROP.d.opinc.2026-04-01.2026-06-30","ROP.d.opinc.2026-07-01.2026-09-30","ROP.d.netinc.2025-01-01.2025-12-31","ROP.d.netinc.2025-01-01.2025-09-30","ROP.d.netinc.2026-01-01.2026-03-31","ROP.d.netinc.2026-04-01.2026-06-30","ROP.d.netinc.2026-07-01.2026-09-30"]},{"topic":"pay","text":"The proxy statement filed 2026-04-07 gives the principal executive officer’s total pay for FY2025 as $26.2 million in its summary compensation table, and the “compensation actually paid” - the SEC’s measure, which revalues share awards over the year - as $3.9 million.","cites":["ROP.pay.peoTotal.2025","ROP.pay.peoPaid.2025"]},{"topic":"pay","text":"For the other named executive officers the same table gives an average of $9.7 million in total and $2.9 million actually paid.","cites":["ROP.pay.neoTotal.2025","ROP.pay.neoPaid.2025"]},{"topic":"pay","text":"The table puts the value of $100 held in the company’s shares over the years it covers at $106.00 at the end of FY2025, and $258.00 for the peer group the company chose.","cites":["ROP.pay.tsr.2025","ROP.pay.peerTsr.2025"]},{"topic":"backlog","text":"Remaining performance obligations - revenue under contract that was not yet recognised - were $5.2 billion at the end of FY2025, against $4.8 billion a year earlier. That is 65.9% of FY2025 revenue (computed from two filed figures).","cites":["ROP.rpo.2025","ROP.rpo.2024","ROP.revenue.2025"]},{"topic":"backlog","text":"Deferred revenue was $1.9 billion at the end of FY2025 (tagged ContractWithCustomerLiabilityCurrent), against $1.7 billion a year earlier.","cites":["ROP.deferred.2025","ROP.deferred.2024"]},{"topic":"people","text":"The latest annual report gives the workforce as 19,400 in its own words. FY2025 revenue works out to about $407,000 for each (computed from one filed figure and the number in that sentence).","cites":["ROP.q.employees","ROP.revenue.2025"]},{"topic":"debt","text":"At the end of FY2025 the balance sheet carried $297 million in cash and cash equivalents, and $9.3 billion of debt as tagged (LongTermDebtNoncurrent + LongTermDebtCurrent). Debt less cash was $9 billion (computed from three filed figures).","cites":["ROP.cash.2025","ROP.debtLong.2025","ROP.debtCurrent.2025"]}]},"fin":{"ROP":{"insiders":{"from":"2025-11-23","to":"2026-11-23","complete":true,"listed":31,"read":31,"other":0,"failed":0,"odd":0,"people":[["HUNN LAURENCE NEIL","President and CEO, director"],["Cross Brandon L","VP & Chief Accounting Officer"],["Stipancich John K","EVP, Chief Legal Officer & Sec"],["Conley Jason","EVP, Chief Financial Officer"],["WALLMAN RICHARD F","Director"],["Joyce Thomas Patrick JR","Director"]],"rows":[["S",0,40000,19699895.66,"2026-11-05","2026-11-05","0001193125-26-451912","2026-11-06",0],["S",1,2000,978600,"2026-11-04","2026-11-04","0001193125-26-449793","2026-11-05",0],["S",2,4200,1965978,"2026-10-30","2026-10-30","0001193125-26-445340","2026-11-03",0],["S",2,3500,1571640,"2026-10-26","2026-10-26","0001193125-26-436134","2026-10-28",0],["S",3,12000,5226353.7,"2026-10-23","2026-10-23","0001193125-26-434200","2026-10-27",0],["S",2,2000,758100,"2026-07-27","2026-07-27","0001193125-26-318076","2026-07-27",0],["S",4,6434,2322674,"2026-07-24","2026-07-24","0001193125-26-318067","2026-07-27",0],["P",5,1400,501844,"2026-02-06","2026-02-06","0001193125-26-041050","2026-02-06",0],["S",3,6000,2673390,"2025-12-01","2025-12-01","0001193125-25-305224","2025-12-02",0]]},"risks":{"compared":true,"prior":"ROP-0000882835-25-000008","threshold":0.5,"counts":{"now":22,"before":21,"same":19,"reworded":2,"elsewhere":0,"new":1,"removed":0},"new":["ROP.q.risk.0"],"removed":[],"reworded":[["ROP.q.riskrw.0","ROP.q.riskrwwas.0",0.92],["ROP.q.riskrw.1","ROP.q.riskrwwas.1",0.92]]}}},"quotes":{"ROP.q.employees":{"c":"ROP","kind":"employees","n":19400,"quote":"As of December 31, 2025, we employed approximately 19,400 people worldwide on a consolidated basis, of which approximately 13,100 were employed in the U.S. and approximately 6,300 were employed outside of the U.S.","source":"ROP-0000882835-26-000009","section":"Item 1. Business","date":"2026-02-24","proof":"068dc608c2fdf916cdd3b21fefc06d32d61535bc3dbf9e91043a085fb317a020"},"ROP.q.risk.0":{"c":"ROP","kind":"risk","quote":"Regulation limiting or controlling the use of AI may restrict our ability to use AI, our ability to create new products, and create increased compliance costs.","source":"ROP-0000882835-26-000009","section":"Risk factors","date":"2026-02-24","proof":"cf8e227d10fc1371cd09bdd092a4456bf8e5e92a6df38b8d45a54f4578cce07b"},"ROP.q.riskrw.0":{"c":"ROP","kind":"risk","quote":"We use AI in our business, and challenges with properly managing its use could result in reputational harm, competitive harm, and legal liability, and adversely affect our results of operations.","source":"ROP-0000882835-26-000009","section":"Risk factors","date":"2026-02-24","proof":"8190f4967e340a321e3de44154dfbe17721b1f5b788e2c9f44e3e0de2d0ee01b"},"ROP.q.riskrwwas.0":{"c":"ROP","kind":"risk-was","quote":"We use artificial intelligence in our business, and challenges with properly managing its use could result in reputational harm, competitive harm, and legal liability, and adversely affect our results of operations.","source":"ROP-0000882835-25-000008","section":"Risk factors","date":"2025-02-24","proof":"d920c988d560823370b2a21dade9318549a49a2dd6a33bf02b6e5637d7a2ae80"},"ROP.q.riskrw.1":{"c":"ROP","kind":"risk","quote":"Our non-operating results may be adversely impacted by the performance of Indicor, in which we own a minority interest.","source":"ROP-0000882835-26-000009","section":"Risk factors","date":"2026-02-24","proof":"9da3c361489ce06c5a797b098220d6030e1e68b25d7dbe72b5b57298cada913a"},"ROP.q.riskrwwas.1":{"c":"ROP","kind":"risk-was","quote":"Our operating results may be adversely impacted by the performance of Indicor, in which we own a minority interest.","source":"ROP-0000882835-25-000008","section":"Risk factors","date":"2025-02-24","proof":"9f583e10b9e23b51a1dc881a8a0bffad0f1ec3438c8547da3