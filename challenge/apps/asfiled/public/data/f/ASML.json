5":{"c":"ASML","m":"rpo","fy":2025,"end":"2025-12-31","v":46500000000,"u":"EUR","tag":"us-gaap:RevenueRemainingPerformanceObligation","a":"0001628280-26-011378"},"ASML.deferred.2024":{"c":"ASML","m":"deferred","fy":2024,"end":"2024-12-31","v":18196200000,"u":"EUR","tag":"us-gaap:ContractWithCustomerLiability","a":"0000937966-25-000009"},"ASML.deferred.2025":{"c":"ASML","m":"deferred","fy":2025,"end":"2025-12-31","v":19372600000,"u":"EUR","tag":"us-gaap:ContractWithCustomerLiability","a":"0001628280-26-011378"}},"filings":{"0001193125-15-042676":{"c":"ASML","form":"20-F","filed":"2015-02-11"},"0000937966-16-000017":{"c":"ASML","form":"20-F","filed":"2016-02-05"},"0000937966-17-000007":{"c":"ASML","form":"20-F","filed":"2017-02-08"},"0000937966-18-000007":{"c":"ASML","form":"20-F","filed":"2018-02-07"},"0000937966-19-000007":{"c":"ASML","form":"20-F","filed":"2019-02-06"},"0000937966-20-000011":{"c":"ASML","form":"20-F","filed":"2020-02-12"},"0000937966-21-000007":{"c":"ASML","form":"20-F","filed":"2021-02-10"},"0000937966-22-000013":{"c":"ASML","form":"20-F","filed":"2022-02-09"},"0000937966-23-000014":{"c":"ASML","form":"20-F","filed":"2023-02-15"},"0000937966-24-000008":{"c":"ASML","form":"20-F","filed":"2024-02-14"},"0000937966-25-000009":{"c":"ASML","form":"20-F","filed":"2025-03-05"},"0001628280-26-011378":{"c":"ASML","form":"20-F","filed":"2026-02-25"}},"finsights":{"ASML":[{"topic":"fcf","text":"Free cash flow was €11.1 billion in FY2025: operating cash flow of €12.7 billion less capital spending of €1.6 billion (computed from two filed figures). That is 33.9% of revenue. In FY2020 it was €3.7 billion.","cites":["ASML.ocf.2025","ASML.capex.2025","ASML.revenue.2025","ASML.ocf.2020","ASML.capex.2020"]},{"topic":"sbc","text":"Stock-based compensation was €202 million in FY2025, 0.6% of revenue, against 0.4% in FY2020.","cites":["ASML.sbc.2025","ASML.revenue.2025","ASML.sbc.2020","ASML.revenue.2020"]},{"topic":"returns","text":"In FY2025 the company paid €6 billion to repurchase its own shares and €2.6 billion in dividends: €8.5 billion together (computed from two filed figures).","cites":["ASML.buybacks.2025","ASML.dividends.2025"]},{"topic":"backlog","text":"Remaining performance obligations - revenue under contract that was not yet recognised - were €46.5 billion at the end of FY2025, against €43.3 billion a year earlier. That is 142.3% of FY2025 revenue (computed from two filed figures).","cites":["ASML.rpo.2025","ASML.rpo.2024","ASML.revenue.2025"]},{"topic":"backlog","text":"Deferred revenue was €19.4 billion at the end of FY2025 (tagged ContractWithCustomerLiability), against €18.2 billion a year earlier.","cites":["ASML.deferred.2025","ASML.deferred.2024"]},{"topic":"people","text":"The latest annual report gives the workforce as 44,000 in its own words. FY2025 revenue works out to about €742,000 for each (computed from one filed figure and the number in that sentence).","cites":["ASML.q.employees","ASML.revenue.2025"]},{"topic":"debt","text":"At the end of FY2025 the balance sheet carried €12.9 billion in cash and cash equivalents and €406 million in short-term investments, and €4.4 billion of debt as tagged (LongTermDebtNoncurrent + LongTermDebtCurrent). Cash and short-term investments exceeded that debt by €8.9 billion (computed from four filed figures).","cites":["ASML.cash.2025","ASML.sti.2025","ASML.debtLong.2025","ASML.debtCurrent.2025"]}]},"fin":{"ASML":{}},"quotes":{"ASML.q.employees":{"c":"ASML","kind":"employees","n":44000,"quote":"we are a global team of more than 44,000 employees (FTEs).","source":"ASML-0001628280-26-011378","section":"Annual report","date":"2026-02-25","proof":"08e93d2ed45d0c969e28ebf8fefb3e43154e363c166f4dc8d1f4f096c3a9495e"}}}