,"2025-12-09","2025-12-10","0001655286-25-000009","2025-12-11",1],["S",10,84676,1960012.31,"2025-12-08","2025-12-08","0001548933-25-000006","2025-12-09",1],["S",11,29000,689968,"2025-12-08","2025-12-08","0001646850-25-000006","2025-12-10",0]]},"risks":{"compared":true,"prior":"HPE-0001645590-24-000139","threshold":0.5,"counts":{"now":34,"before":33,"same":20,"reworded":4,"elsewhere":1,"new":9,"removed":8},"new":["HPE.q.risk.0","HPE.q.risk.1","HPE.q.risk.2","HPE.q.risk.3","HPE.q.risk.4","HPE.q.risk.5","HPE.q.risk.6","HPE.q.risk.7","HPE.q.risk.8"],"removed":["HPE.q.riskgone.0","HPE.q.riskgone.1","HPE.q.riskgone.2","HPE.q.riskgone.3","HPE.q.riskgone.4","HPE.q.riskgone.5","HPE.q.riskgone.6","HPE.q.riskgone.7"],"reworded":[["HPE.q.riskrw.0","HPE.q.riskrwwas.0",0.55],["HPE.q.riskrw.1","HPE.q.riskrwwas.1",0.73],["HPE.q.riskrw.2","HPE.q.riskrwwas.2",0.74],["HPE.q.riskrw.3","HPE.q.riskrwwas.3",0.9]]}}},"quotes":{"HPE.q.employees":{"c":"HPE","kind":"employees","n":67000,"quote":"Our company strives to be an engine of innovation, and our approximately 67,000 employees as of October 31, 2025, are proud of the ways our technology enables our customers to achieve meaningful outcomes like curing disease, modernizing farming, addressing world-hunger, and democratizing transportation through autonomous vehicles.","source":"HPE-0001645590-25-000130","section":"Item 1. Business","date":"2025-12-18","proof":"c4801c8503c2ac79880308099a0f4b07db98652e37db00528cdfce9588cbbac9"},"HPE.q.risk.0":{"c":"HPE","kind":"risk","quote":"Our success depends on our ability to successfully execute our go-to-market strategy, including offering solutions as-a-Service, effectively planning and managing our resources, and continuing to develop and manage our offerings to integrate new features and solutions.","source":"HPE-0001645590-25-000130","section":"Risk factors","date":"2025-12-18","proof":"d68bc3d4b1fcc9269292a9d6510eb57bd855682a22736d6bce1bdb60f971e731"},"HPE.q.risk.1":{"c":"HPE","kind":"risk","quote":"Uncertainty and fluctuations in geopolitical and macroeconomic conditions may adversely impact our business, financial condition, and operating results.","source":"HPE-0001645590-25-000130","section":"Risk factors","date":"2025-12-18","proof":"58606ae3f6454232542f31180d746aea413ba7d31d6066f46672ded9c4c4dba8"},"HPE.q.risk.2":{"c":"HPE","kind":"risk","quote":"Long sales and implementation cycles for our offerings and dynamics related to large orders may cause our revenues and operating results to vary significantly from quarter-to-quarter.","source":"HPE-0001645590-25-000130","section":"Risk factors","date":"2025-12-18","proof":"c4f11eae9368509a5d24e3b0b9c804e7dd72c2cc72ec7ee042873e23626ff057"},"HPE.q.risk.3":{"c":"HPE","kind":"risk","quote":"Our ability to achieve our strategy could be harmed if we are unable to attract, retain, train, motivate, develop, and transition key personnel.","source":"HPE-0001645590-25-000130","section":"Risk factors","date":"2025-12-18","proof":"2a4a001c20c20e70b61f0cc7ea55c3a2c9c79ffa24d6cd8b05fc52ea2ed8b430"},"HPE.q.risk.4":{"c":"HPE","kind":"risk","quote":"We may not achieve some or all of the expected benefits of our cost reduction actions, some or all of which may be disruptive to our business.","source":"HPE-0001645590-25-000130","section":"Risk factors","date":"2025-12-18","proof":"4534dc264517307cc8975448d2944fd94bdcb9815533efdf421d7d6a0d823b43"},"HPE.q.risk.5":{"c":"HPE","kind":"risk","quote":"We rely on the performance of our business systems and processes, as well as those of third-parties with whom we do business.","source":"HPE-0001645590-25-000130","section":"Risk factors","date":"2025-12-18","proof":"62ac73413bcc828c576ce1e1405a2bd6f581c1f82520db480ba85a185adb1275"},"HPE.q.risk.6":{"c":"HPE","kind":"risk","quote":"Our sustainable and responsible business expectations and actions towards achieving our Living Progress objectives may expose us to operational, legal, or reputational risks and could adversely affect our business, results of operations, financial condition, or stock price.","source":"HPE-0001645590-25-000130","section":"Risk factors","date":"2025-12-18","proof":"277fd1dc58260858e9a517d72c7a7103523d497229c8c708c6e50362fdcd1df5"},"HPE.q.risk.7":{"c":"HPE","kind":"risk","quote":"Our revenue, profitability, and margins have historically varied, and we expect them to continue to vary over time.","source":"HPE-0001645590-25-000130","section":"Risk factors","date":"2025-12-18","proof":"156a172d7c99b2ec732677ab8558346b84741e3b5c6dc4b3365cc1e7a37e70e0"},"HPE.q.risk.8":{"c":"HPE","kind":"risk","quote":"Unfavorable results of legal proceedings, investigations, and other disputes could harm our business and result in substantial costs.","source":"HPE-0001645590-25-000130","section":"Risk factors","date":"2025-12-18","proof":"c8e30016389e8d72e132831feb129a4ad4dc304cca62ad66014795a88d5a7db7"},"HPE.q.riskgone.0":{"c":"HPE","kind":"risk-was","quote":"If we cannot successfully execute our go-to-market strategy, including offering our entire portfolio as-a-Service, our business, operating results, and financial performance may suffer.","source":"HPE-0001645590-24-000139","section":"Risk factors","date":"2024-12-19","proof":"5997585827f97011290d5d4a07220454e190f61513ce13ed840135c218b63a11"},"HPE.q.riskgone.1":{"c":"HPE","kind":"risk-was","quote":"Failure to complete the Merger with Juniper Networks may adversely affect our business and our stock price.","source":"HPE-0001645590-24-000139","section":"Risk factors","date":"2024-12-19","proof":"35aeff76e4d2b770f0ba7747ada9a5304e1ef3e8f7fe5bf43d59d171418422d4"},"HPE.q.riskgone.2":{"c":"HPE","kind":"risk-was","quote":"Failure to realize the benefits expected from the Merger with Juniper Networks could adversely affect our business or our stock price.","source":"HPE-0001645590-24-000139","section":"Risk factors","date":"2024-12-19","proof":"d4bc7133270d9abfa1835df4336feeef56f74793ba19f2ef5264926e16aba33e"},"HPE.q.riskgone.3":{"c":"HPE","kind":"risk-was","quote":"In order to be successful, we must attract, retain, train, motivate, develop, and transition key employees, and failure to do so could seriously harm us.","source":"HPE-0001645590-24-000139","section":"Risk factors","date":"2024-12-19","proof":"f45906a62739afe2ea2a1653ecc814301d92cf6c3a1f35b9d6ec26546f6e7525"},"HPE.q.riskgone.4":{"c":"HPE","kind":"risk-was","quote":"Changes in the macroeconomic environment have, at times, impacted and may in the future negatively impact our results of operations.","source":"HPE-0001645590-24-000139","section":"Risk factors","date":"2024-12-19","proof":"62ddc9036e835209a24663e0075854eda9e3e92249060313f53345cb2adadc91"},"HPE.q.riskgone.5":{"c":"HPE","kind":"risk-was","quote":"Failure to meet responsible and sustainable business expectations or standards or achieve our Living Progress goals could adversely affect our business, results of operations, financial condition, or stock price.","source":"HPE-0001645590-24-000139","section":"Risk factors","date":"2024-12-19","proof":"65b0caff352d50aab70aec2abb90dea1be00b22eaf5a9b23bdb262712f0d392b"},"HPE.q.riskgone.6":{"c":"HPE","kind":"risk-was","quote":"The revenue and profitability of our operations have historically varied, which makes our future financial results less predictable.","source":"HPE-0001645590-24-000139","section":"Risk factors","date":"2024-12-19","proof":"df7e67b3f6ea0215aaf9063062feeed320842f0d9207d870552382ee14274f96"},"HPE.q.riskgone.7":{"c":"HPE","kind":"risk-was","quote":"The stock distribution in either or both of the completed separations of our former Enterprise Services business and our former Software segment could result in significant tax liability, and DXC Technology Company or Micro Focus International plc (as applicable) may in certain cases be obligated to indemnify us for any such tax liability imposed on us.","source":"HPE-0001645590-24-000139","section":"Risk factors","date":"2024-12-19","proof":"328cd6bd1376d77441febacdae466755478b4e1b84806452c7eefb895f4688a9"},"HPE.q.riskrw.0":{"c":"HPE","kind":"risk","quote":"We depend on third-party suppliers, contract manufacturers (including original equipment and original design manufacturers), as well as single-source and limited source suppliers, and our financial results could suffer if we fail to manage these third party relationships effectively.","source":"HPE-0001645590-25-000130","section":"Risk factors","date":"2025-12-18","proof":"370f831676265e8aa8624cb4d8eb9bebf174fa05b3549e3fff49cf12ed93b638"},"HPE.q.riskrwwas.0":{"c":"HPE","kind":"risk-was","quote":"We depend on third-party suppliers, and our financial results could suffer if we fail to manage our supplier relationships properly.","source":"HPE-0001645590-24-000139","section":"Risk factors","date":"2024-12-19","proof":"7cc324520ce82068cf4c6251e94bd75300f54ba9d1aa086b8ddb25bb19acbf82"},"HPE.q.riskrw.1":{"c":"HPE","kind":"risk","quote":"Any failure by us to identify, manage, and complete acquisitions and subsequent integrations (including the integration of Juniper Networks following the Merger), divestitures, and other significant transactions successfully could harm our financial results, business, prospects, and stock price.","source":"HPE-0001645590-25-000130","section":"Risk factors","date":"2025-12-18","proof":"d5c534db19d3efb48d709f949e26c82f5247eeee4c7d766308d1486519a819da"},"HPE.q.riskrwwas.1":{"c":"HPE","kind":"risk-was","quote":"Any failure by us to identify, manage, and complete acquisitions and subsequent integrations, divestitures, and other significant transactions successfully could harm our financial results, business and prospects.","source":"HPE-0001645590-24-000139","section":"Risk factors","date":"2024-12-19","proof":"b2cac90f014c33d354ccd33484caa1e5d15d8dd79274f0199ede6384ee31d538"},"HPE.q.riskrw.2":{"c":"HPE","kind":"risk","quote":"If we experience or fail to properly manage disruption in the distribution of our products and services properly, our business and financial performance could suffer.","source":"HPE-0001645590-25-000130","section":"Risk factors","date":"2025-12-18","proof":"83b7b3c586ad238688b759a2c7f79e61184fa469a0c035ecc949f6c7a4b87958"},"HPE.q.riskrwwas.2":{"c":"HPE","kind":"risk-was","quote":"If we fail to manage the distribution of our products and services properly, our business and financial performance could suffer.","source":"HPE-0001645590-24-000139","section":"Risk factors","date":"2024-12-19","proof":"7340173f88591729d6c1fc73037b74b62d2adfd6bf6712ca29481a17aa10e6e6"},"HPE.q.riskrw.3":{"c":"HPE","kind":"risk","quote":"Due to the international nature of our business, political or economic changes and the laws and regulatory regimes applying to international transactions or other factors could harm our future revenue, costs and expenses, financial condition, and results of operations.","source":"HPE-0001645590-25-000130","section":"Risk factors","date":"2025-12-18","proof":"47d4f6c5d1acae06c7e924cd4f112744d5628c61dca80ab5789174b285f8c5ff"},"HPE.q.riskrwwas.3":{"c":"HPE","kind":"risk-was","quote":"Due to the international nature of our business, political or economic changes and the laws and regulatory regimes applying to international transactions or other factors could harm our future revenue, costs and expenses, and financial condition.","source":"HPE-0001645590-24-000139","section":"Risk factors","date":"2024-12-19","proof":"f4513e2117b7cc3442493a9f83a473cab78e3d2e0ce3da15c70ed209a9d3a6a5"}},"sources":{"HPE-0001645590-24-000139":{"kind":"prior-annual-report","by":"HPE","form":"10-K","period":"2024-10-31","date":"2024-12-19","accn":"0001645590-24-000139","title":"HPE 10-K for the fiscal year ended 2024-10-31","url":"https://www.sec.gov/Archives/edgar/data/1645590/000164559024000139/hpe-20241031.htm","sha":"ee88487374915be8a279b00c88054aaad773032351bcf001db8e9e47ca77a98a"}}}