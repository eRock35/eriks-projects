":"10-Q","filed":"2025-08-27"},"0001193125-25-297237":{"c":"NTAP","form":"10-Q","filed":"2025-11-25"},"0001193125-26-076622":{"c":"NTAP","form":"10-Q","filed":"2026-02-26"},"0001193125-26-380207":{"c":"NTAP","form":"10-Q","filed":"2026-09-02"},"0000950170-24-101408":{"c":"NTAP","form":"10-Q","filed":"2024-08-28"},"0001193125-26-321210":{"c":"NTAP","form":"DEF 14A","filed":"2026-07-28"}},"finsights":{"NTAP":[{"topic":"fcf","text":"Free cash flow was $1.9 billion in FY2026: operating cash flow of $2.1 billion less capital spending of $198 million (computed from two filed figures). That is 27% of revenue. In FY2021 it was $1.2 billion.","cites":["NTAP.ocf.2026","NTAP.capex.2026","NTAP.revenue.2026","NTAP.ocf.2021","NTAP.capex.2021"]},{"topic":"sbc","text":"Stock-based compensation was $382 million in FY2026, 5.5% of revenue, against 3.4% in FY2021.","cites":["NTAP.sbc.2026","NTAP.revenue.2026","NTAP.sbc.2021","NTAP.revenue.2021"]},{"topic":"returns","text":"In FY2026 the company paid $950 million to repurchase its own shares and $413 million in dividends: $1.4 billion together (computed from two filed figures).","cites":["NTAP.buybacks.2026","NTAP.dividends.2026"]},{"topic":"quarter","text":"In the three months ended 2026-07-31 revenue was $2 billion, up 29.9% from $1.6 billion in the three months ended 2025-07-25.","cites":["NTAP.d.revenue.2026-04-25.2026-07-31","NTAP.d.revenue.2025-04-26.2025-07-25"]},{"topic":"ttm","text":"Over the four quarters to 2026-07-31 revenue added up to $7.4 billion (computed from five filed figures), operating income to $1.8 billion and net income to $1.4 billion.","cites":["NTAP.d.revenue.2025-07-26.2025-10-24","NTAP.d.revenue.2025-10-25.2026-01-23","NTAP.d.revenue.2025-04-26.2026-04-24","NTAP.d.revenue.2025-04-26.2026-01-23","NTAP.d.revenue.2026-04-25.2026-07-31","NTAP.d.opinc.2025-07-26.2025-10-24","NTAP.d.opinc.2025-10-25.2026-01-23","NTAP.d.opinc.2025-04-26.2026-04-24","NTAP.d.opinc.2025-04-26.2026-01-23","NTAP.d.opinc.2026-04-25.2026-07-31","NTAP.d.netinc.2025-07-26.2025-10-24","NTAP.d.netinc.2025-10-25.2026-01-23","NTAP.d.netinc.2025-04-26.2026-04-24","NTAP.d.netinc.2025-04-26.2026-01-23","NTAP.d.netinc.2026-04-25.2026-07-31"]},{"topic":"ttm","text":"Free cash flow over the same four quarters was $1.6 billion: operating cash flow of $1.9 billion less capital spending of $247 million (computed from ten filed figures).","cites":["NTAP.d.ocf.2025-04-26.2025-10-24","NTAP.d.ocf.2025-04-26.2025-07-25","NTAP.d.ocf.2025-04-26.2026-01-23","NTAP.d.ocf.2025-04-26.2026-04-24","NTAP.d.ocf.2026-04-25.2026-07-31","NTAP.d.capex.2025-04-26.2025-10-24","NTAP.d.capex.2025-04-26.2025-07-25","NTAP.d.capex.2025-04-26.2026-01-23","NTAP.d.capex.2025-04-26.2026-04-24","NTAP.d.capex.2026-04-25.2026-07-31"]},{"topic":"pay","text":"The proxy statement filed 2026-07-28 gives the principal executive officer’s total pay for FY2026 as $22.2 million in its summary compensation table, and the “compensation actually paid” - the SEC’s measure, which revalues share awards over the year - as $22.5 million.","cites":["NTAP.pay.peoTotal.2026","NTAP.pay.peoPaid.2026"]},{"topic":"pay","text":"For the other named executive officers the same table gives an average of $15.9 million in total and $15.6 million actually paid.","cites":["NTAP.pay.neoTotal.2026","NTAP.pay.neoPaid.2026"]},{"topic":"pay","text":"The table puts the value of $100 held in the company’s shares over the years it covers at $163.57 at the end of FY2026, and $260.29 for the peer group the company chose.","cites":["NTAP.pay.tsr.2026","NTAP.pay.peerTsr.2026"]},{"topic":"backlog","text":"Deferred revenue was $2.3 billion at the end of FY2026 (tagged ContractWithCustomerLiabilityCurrent).","cites":["NTAP.deferred.2026"]},{"topic":"people","text":"The latest annual report gives the workforce as 11,700 in its own words. FY2026 revenue works out to about $592,000 for each (computed from one filed figure and the number in that sentence).","cites":["NTAP.q.employees","NTAP.revenue.2026"]},{"topic":"flags","text":"The FY2026 annual report tags restructuring charges of $21 million, after $83 million in FY2025.","cites":["NTAP.restructuring.2026","NTAP.restructuring.2025"]},{"topic":"debt","text":"At the end of FY2026 the balance sheet carried $2.1 billion in cash and cash equivalents and $1.5 billion in short-term investments, and $2.5 billion of debt as tagged (LongTermDebtNoncurrent + LongTermDebtCurrent + CommercialPaper). Cash and short-term investments exceeded that debt by $1.1 billion (computed from five filed figures).","cites":["NTAP.cash.2026","NTAP.sti.2026","NTAP.debtLong.2026","NTAP.debtCurrent.2026","NTAP.debtShort.2026"]}]},"fin":{"NTAP":{"insiders":{"from":"2025-11-23","to":"2026-11-23","complete":true,"listed":79,"read":79,"other":0,"failed":0,"odd":0,"people":[["CERNUDA CESAR","President"],["O'Callahan Elizabeth M","EVP, Chief Admin. Officer"],["Palin Carrie","Director"],["Kurian George","CEO, director"],["HELD GERALD","Director"],["Ahuja Deepak","Director"],["NEVENS THOMAS MICHAEL","Director"],["De Lorenzo Daniel","VP, Controller & CAO"]],"rows":[["S",0,2609,466750.1,"2026-11-16","2026-11-16","0001193125-26-467163","2026-11-18",1],["S",1,1000,175950,"2026-11-10","2026-11-10","0001193125-26-458950","2026-11-12",1],["S",1,1000,237420,"2026-10-12","2026-10-12","0001193125-26-421729","2026-10-14",1],["S",2,5000,1082150,"2026-10-02","2026-10-02","0001193125-26-415633","2026-10-06",0],["S",3,10000,2100406.69,"2026-10-01","2026-10-01","0001193125-26-414222","2026-10-05",1],["S",4,5757,1220484,"2026-10-01","2026-10-01","0001193125-26-414223","2026-10-05",0],["S",3,50000,10497500,"2026-09-29","2026-09-29","0001193125-26-410739","2026-10-01",1],["S",3,37000,7398150,"2026-09-24","2026-09-24","0001193125-26-405401","2026-09-28",1],["S",5,3450,690000,"2026-09-21","2026-09-21","0001193125-26-399472","2026-09-23",1],["S",3,13000,2600130,"2026-09-21","2026-09-21","0001193125-26-399475","2026-09-23",1],["S",3,40000,7656794,"2026-09-14","2