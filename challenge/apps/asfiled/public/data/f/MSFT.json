-K","filed":"2024-07-30"},"0000950170-25-100235":{"c":"MSFT","form":"10-K","filed":"2025-07-30"},"0001193125-26-323660":{"c":"MSFT","form":"10-K","filed":"2026-07-29"},"0000950170-25-010491":{"c":"MSFT","form":"10-Q","filed":"2025-01-29"},"0000950170-25-061046":{"c":"MSFT","form":"10-Q","filed":"2025-04-30"},"0001193125-25-256321":{"c":"MSFT","form":"10-Q","filed":"2025-10-29"},"0001193125-26-027207":{"c":"MSFT","form":"10-Q","filed":"2026-01-28"},"0001193125-26-191507":{"c":"MSFT","form":"10-Q","filed":"2026-04-29"},"0001193125-26-436133":{"c":"MSFT","form":"10-Q","filed":"2026-10-28"},"0001193125-26-427849":{"c":"MSFT","form":"DEF 14A","filed":"2026-10-21"}},"finsights":{"MSFT":[{"topic":"fcf","text":"Free cash flow was $67 billion in FY2026: operating cash flow of $183 billion less capital spending of $116 billion (computed from two filed figures). That is 20.2% of revenue. In FY2021 it was $56.1 billion.","cites":["MSFT.ocf.2026","MSFT.capex.2026","MSFT.revenue.2026","MSFT.ocf.2021","MSFT.capex.2021"]},{"topic":"sbc","text":"Stock-based compensation was $12.4 billion in FY2026, 3.7% of revenue, against 3.6% in FY2021.","cites":["MSFT.sbc.2026","MSFT.revenue.2026","MSFT.sbc.2021","MSFT.revenue.2021"]},{"topic":"returns","text":"In FY2026 the company paid $22.3 billion to repurchase its own shares and $26.4 billion in dividends: $48.7 billion together (computed from two filed figures).","cites":["MSFT.buybacks.2026","MSFT.dividends.2026"]},{"topic":"quarter","text":"In the three months ended 2026-09-30 revenue was $92.3 billion, up 18.8% from $77.7 billion in the three months ended 2025-09-30.","cites":["MSFT.d.revenue.2026-07-01.2026-09-30","MSFT.d.revenue.2025-07-01.2025-09-30"]},{"topic":"ttm","text":"Over the four quarters to 2026-09-30 revenue added up to $346 billion (computed from five filed figures), operating income to $163 billion and net income to $143 billion.","cites":["MSFT.d.revenue.2025-10-01.2025-12-31","MSFT.d.revenue.2026-01-01.2026-03-31","MSFT