orm":"10-K","filed":"2022-02-17"},"0001609711-23-000031":{"c":"GDDY","form":"10-K","filed":"2023-02-16"},"0001609711-24-000022":{"c":"GDDY","form":"10-K","filed":"2024-02-29"},"0001609711-25-000023":{"c":"GDDY","form":"10-K","filed":"2025-02-20"},"0001609711-26-000010":{"c":"GDDY","form":"10-K","filed":"2026-02-25"},"0001609711-24-000167":{"c":"GDDY","form":"10-Q","filed":"2024-10-31"},"0001609711-25-000077":{"c":"GDDY","form":"10-Q","filed":"2025-05-02"},"0001609711-25-000154":{"c":"GDDY","form":"10-Q","filed":"2025-08-08"},"0001609711-25-000209":{"c":"GDDY","form":"10-Q","filed":"2025-10-31"},"0001609711-26-000037":{"c":"GDDY","form":"10-Q","filed":"2026-05-01"},"0001609711-26-000088":{"c":"GDDY","form":"10-Q","filed":"2026-07-31"},"0001609711-26-000120":{"c":"GDDY","form":"10-Q","filed":"2026-10-30"}},"finsights":{"GDDY":[{"topic":"fcf","text":"Free cash flow was $1.6 billion in FY2025: operating cash flow of $1.6 billion less capital spending of $23.9 million (computed from two filed figures). That is 31.8% of revenue. In FY2020 it was $698 million.","cites":["GDDY.ocf.2025","GDDY.capex.2025","GDDY.revenue.2025","GDDY.ocf.2020","GDDY.capex.2020"]},{"topic":"sbc","text":"Stock-based compensation was $318 million in FY2025, 6.4% of revenue, against 5.8% in FY2020.","cites":["GDDY.sbc.2025","GDDY.revenue.2025","GDDY.sbc.2020","GDDY.revenue.2020"]},{"topic":"returns","text":"In FY2025 the company paid $1.6 billion to repurchase its own shares. No dividend payment is tagged for the year.","cites":["GDDY.buybacks.2025"]},{"topic":"quarter","text":"In the three months ended 2026-09-30 revenue was $1.3 billion, up 6% from $1.3 billion in the three months ended 2025-09-30.","cites":["GDDY.d.revenue.2026-07-01.2026-09-30","GDDY.d.revenue.2025-07-01.2025-09-30"]},{"topic":"ttm","text":"Over the four quarters to 2026-09-30 revenue added up to $5.2 billion (computed from five filed figures), operating income to $1.3 billion and net income to $962 million.","cites":["GDDY.d.revenue.2025-01-01.2025-12-31","GDDY.d.revenue.2025-01-01.2025-09-30","GDDY.d.revenue.2026-01-01.2026-03-31","GDDY.d.revenue.2026-04-01.2026-06-30","GDDY.d.revenue.2026-07-01.2026-09-30","GDDY.d.opinc.2025-01-01.2025-12-31","GDDY.d.opinc.2025-01-01.2025-09-30","GDDY.d.opinc.2026-01-01.2026-03-31","GDDY.d.opinc.2026-04-01.2026-06-30","GDDY.d.opinc.2026-07-01.2026-09-30","GDDY.d.netinc.2025-01-01.2025-12-31","GDDY.d.netinc.2025-01-01.2025-09-30","GDDY.d.netinc.2026-01-01.2026-03-31","GDDY.d.netinc.2026-04-01.2026-06-30","GDDY.d.netinc.2026-07-01.2026-09-30"]},{"topic":"ttm","text":"Free cash flow over the same four quarters was $1.7 billion: operating cash flow of $1.8 billion less capital spending of $28.5 million (computed from ten filed figures).","cites":["GDDY.d.ocf.2025-01-01.2025-12-31","GDDY.d.ocf.2025-01-01.2025-09-30","GDDY.d.ocf.2026-01-01.2026-03-31","GDDY.d.ocf.2026-01-01.2026-06-30","GDDY.d.ocf.2026-01-01.2026-09-30","GDDY.d.capex.2025-01-01.2025-12-31","GDDY.d.capex.2025-01-01.2025-09-30","GDDY.d.capex.2026-01-01.2026-03-31","GDDY.d.capex.2026-01-01.2026-06-30","GDDY.d.capex.2026-01-01.2026-09-30"]},{"topic":"backlog","text":"Remaining performance obligations - revenue under contract that was not yet recognised - were $3.3 billion at the end of FY2025, against $3.1 billion a year earlier. That is 67% of FY2025 revenue (computed from two filed figures).","cites":["GDDY.rpo.2025","GDDY.rpo.2024","GDDY.revenue.2025"]},{"topic":"backlog","text":"Deferred revenue was $2.4 billion at the end of FY2025 (tagged ContractWithCustomerLiabilityCurrent), against $2.2 billion a year earlier.","cites":["GDDY.deferred.2025","GDDY.deferred.2024"]},{"topic":"people","text":"The latest annual report gives the workforce as 5,845 in its own words. FY2025 revenue works out to about $847,000 for each (computed from one filed figure and the number in that sentence).","cites":["GDDY.q.employees","GDDY.revenue.2025"]},{"topic":"flags","text":"The FY2025 annual report tags restructuring charges of $10.2 million, after $65.5 million in FY2024.","cites":["GDDY.restructuring.2025","GDDY.restructuring.2024"]}]},"fin":{"GDDY":{}},"quotes":{"GDDY.q.employees":{"c":"GDDY","kind":"employees","n":5845,"quote":"As of December 31, 2025, we employed 5,845 people worldwide, made up of 2,414 in technology and development, 2,237 in care and services (who represent the portion of our GoDaddy Guides that are employed directly by GoDaddy), 369 in marketing and advertising and 825 in general and administrative functions.","source":"GDDY-0001609711-26-000010","section":"Item 1. Business","date":"2026-02-25","proof":"956c4d498c994b27b856235bec9cee684cdf3d92e1127ad12d8b39f09dbe2c35"}}}