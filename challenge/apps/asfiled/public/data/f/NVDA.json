to counterparty risks.","source":"NVDA-0001045810-26-000021","section":"Risk factors","date":"2026-02-25","proof":"978c2263373ff44e330289e3b43ab707d10b94aa6b5e828c352c282fbf222a95"},"NVDA.q.riskgone.0":{"c":"NVDA","kind":"risk-was","quote":"The AI Diffusion IFR would encourage our customers to invest in alternatives that are not affected by USG regulations, including foreign competition.","source":"NVDA-0001045810-25-000023","section":"Risk factors","date":"2025-02-26","proof":"09865c79ac4a2a5c879cc642a08799b5d53934b570f46922b51835e70fa4defc"},"NVDA.q.riskgone.1":{"c":"NVDA","kind":"risk-was","quote":"The AI Diffusion IFR would expose U.S. providers and the U.S. industry to an enhanced risk of retaliation from other countries, in the form of tariffs, import/export controls, or other regulatory actions.","source":"NVDA-0001045810-25-000023","section":"Risk factors","date":"2025-02-26","proof":"60728fb3124b3ddef49dfcab0008b42eccd370ccc2f4c266d5deea2cd03a3de7"},"NVDA.q.riskgone.2":{"c":"NVDA","kind":"risk-was","quote":"The AI Diffusion IFR’s licensing requirement could impact our ability to complete development of products in a timely manner, support existing customers using covered products, or supply customers with covered products outside the impacted regions, and may require us to transition certain operations out of one or more of the identified countries.","source":"NVDA-0001045810-25-000023","section":"Risk factors","date":"2025-02-26","proof":"2e0453ddf3b5d92cffdb286ce45672683334d83cc833df127215dde4c441e2e9"},"NVDA.q.riskrw.0":{"c":"NVDA","kind":"risk","quote":"Long manufacturing lead times and uncertain supply and capacity availability, combined with a failure to estimate customer demand accurately, has led and could lead to mismatches between supply and demand.","source":"NVDA-0001045810-26-000021","section":"Risk factors","date":"2026-02-25","proof":"5f843f03b38dd6a229eabba8efe46a4a7785d414adf04dd854154e731365a38d"},"NVDA.q.riskrwwas.0":{"c":"NVDA","kind":"risk-was","quote":"Long manufacturing lead times and uncertain supply and component availability, combined with a failure to estimate customer demand accurately, has led and could lead to mismatches between supply and demand.","source":"NVDA-0001045810-25-000023","section":"Risk factors","date":"2025-02-26","proof":"83507d9ecc89ff7c54fdcee6622b3cf94841218c6d7751d15bf3e72dd10d9207"},"NVDA.q.riskrw.1":{"c":"NVDA","kind":"risk","quote":"Scrutiny from shareholders, regulators and others regarding our corporate sustainability practices could result in additional costs or risks and adversely impact our reputation and willingness of customers and suppliers to do business with us.","source":"NVDA-0001045810-26-000021","section":"Risk factors","date":"2026-02-25","proof":"ad31a32d5ed9e3346c3a4295868358fadc0b8de0ceb877407d692ce2afd01b97"},"NVDA.q.riskrwwas.1":{"c":"NVDA","kind":"risk-was","quote":"Increased scrutiny from shareholders, regulators and others regarding our corporate sustainability practices could result in additional costs or risks and adversely impact our reputation and willingness of customers and suppliers to do business with us.","source":"NVDA-0001045810-25-000023","section":"Risk factors","date":"2025-02-26","proof":"e749653a1ef5957ae992ee089f9319a0373fd4d9cbcd30f2c6f6e703d8e62463"}},"sources":{"NVDA-0001045810-25-000023":{"kind":"prior-annual-report","by":"NVDA","form":"10-K","period":"2025-01-26","date":"2025-02-26","accn":"0001045810-25-000023","title":"NVIDIA 10-K for the fiscal year ended 2025-01-26","url":"https://www.sec.gov/Archives/edgar/data/1045810/000104581025000023/nvda-20250126.htm","sha":"75e7bf7b0dcd83176ec3a7e6b4b728f93eafd30ba5f176a0deddd821b4388825"}}}