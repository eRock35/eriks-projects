":"10-Q","filed":"2026-07-29"},"0000813672-26-000121":{"c":"CDNS","form":"10-Q","filed":"2026-10-28"},"0001193125-26-124264":{"c":"CDNS","form":"DEF 14A","filed":"2026-03-25"}},"finsights":{"CDNS":[{"topic":"fcf","text":"Free cash flow was $1.6 billion in FY2025: operating cash flow of $1.7 billion less capital spending of $142 million (computed from two filed figures). That is 30% of revenue. In FY2020 it was $810 million.","cites":["CDNS.ocf.2025","CDNS.capex.2025","CDNS.revenue.2025","CDNS.ocf.2020","CDNS.capex.2020"]},{"topic":"sbc","text":"Stock-based compensation was $455 million in FY2025, 8.6% of revenue, against 7.4% in FY2020.","cites":["CDNS.sbc.2025","CDNS.revenue.2025","CDNS.sbc.2020","CDNS.revenue.2020"]},{"topic":"returns","text":"In FY2025 the company paid $925 million to repurchase its own shares. No dividend payment is tagged for the year.","cites":["CDNS.buybacks.2025"]},{"topic":"quarter","text":"In the three months ended 2026-09-30 revenue was $1.6 billion, up 22% from $1.3 billion in the three months ended 2025-09-30.","cites":["CDNS.d.revenue.2026-07-01.2026-09-30","CDNS.d.revenue.2025-07-01.2025-09-30"]},{"topic":"ttm","text":"Over the four quarters to 2026-09-30 revenue added up to $6.1 billion (computed from five filed figures), operating income to $1.8 billion and net income to $1.4 billion.","cites":["CDNS.d.revenue.2025-01-01.2025-12-31","CDNS.d.revenue.2025-01-01.2025-09-30","CDNS.d.revenue.2026-01-01.2026-03-31","CDNS.d.revenue.2026-04-01.2026-06-30","CDNS.d.revenue.2026-07-01.2026-09-30","CDNS.d.opinc.2025-01-01.2025-12-31","CDNS.d.opinc.2025-01-01.2025-09-30","CDNS.d.opinc.2026-01-01.2026-03-31","CDNS.d.opinc.2026-04-01.2026-06-30","CDNS.d.opinc.2026-07-01.2026-09-30","CDNS.d.netinc.2025-01-01.2025-12-31","CDNS.d.netinc.2025-01-01.2025-09-30","CDNS.d.netinc.2026-01-01.2026-03-31","CDNS.d.netinc.2026-04-01.2026-06-30","CDNS.d.netinc.2026-07-01.2026-09-30"]},{"topic":"ttm","text":"Free cash flow over the same four quarters was $1.8 billion: operating cash flow of $2 billion less capital spending of $204 million (computed from ten filed figures).","cites":["CDNS.d.ocf.2025-01-01.2025-12-31","CDNS.d.ocf.2025-01-01.2025-09-30","CDNS.d.ocf.2026-01-01.2026-03-31","CDNS.d.ocf.2026-01-01.2026-06-30","CDNS.d.ocf.2026-01-01.2026-09-30","CDNS.d.capex.2025-01-01.2025-12-31","CDNS.d.capex.2025-01-01.2025-09-30","CDNS.d.capex.2026-01-01.2026-03-31","CDNS.d.capex.2026-01-01.2026-06-30","CDNS.d.capex.2026-01-01.2026-09-30"]},{"topic":"pay","text":"For the other named executive officers the same table gives an average of $15.8 million in total and $24.6 million actually paid.","cites":["CDNS.pay.neoTotal.2025","CDNS.pay.neoPaid.2025"]},{"topic":"pay","text":"The table puts the value of $100 held in the company’s shares over the years it covers at $229.00 at the end of FY2025, and $258.00 for the peer group the company chose.","cites":["CDNS.pay.tsr.2025","CDNS.pay.peerTsr.2025"]},{"topic":"backlog","text":"Remaining performance obligations - revenue under contract that was not yet recognised - were $7.8 billion at the end of FY2025, against $6.8 billion a year earlier. That is 147.3% of FY2025 revenue (computed from two filed figures).","cites":["CDNS.rpo.2025","CDNS.rpo.2024","CDNS.revenue.2025"]},{"topic":"backlog","text":"Deferred revenue was $934 million at the end of FY2025 (tagged ContractWithCustomerLiability).","cites":["CDNS.deferred.2025"]},{"topic":"people","text":"The latest annual report gives the workforce as 13,800 in its own words. FY2025 revenue works out to about $384,000 for each (computed from one filed figure and the number in that sentence).","cites":["CDNS.q.employees","CDNS.revenue.2025"]},{"topic":"flags","text":"The FY2025 annual report tags restructuring charges of $29.2 million, after $23.8 million in FY2024.","cites":["CDNS.restructuring.2025","CDNS.restructuring.2024"]},{"topic":"debt","text":"At the end of FY2025 the balance sheet carried $3 billion in cash and cash equivalents and $154 million in short-term investments, and $2.5 billion of debt as tagged (UnsecuredLongTermDebt). Cash and short-term investments exceeded that debt by $675 million (computed from three filed figures).","cites":["CDNS.cash.2025","CDNS.sti.2025","CDNS.debtLong.2025"]}]},"fin":{"CDNS":{"insiders":{"from":"2025-11-23","to":"2026-11-23","complete":true,"listed":79,"read":79,"other":0,"failed":0,"odd":0,"people":[["Cunningham Paul","Sr. Vice President"],["CHEW LEWIS","Director"],["Scannell Paul","Sr. Vice President"],["SANGIOVANNI VINCENTELLI ALBERTO","Director"],["Brennan Ita M","Director"],["TENG CHIN-CHI","Sr. Vice President"],["PLUMMER JAMES D","Director"],["DEVGAN ANIRUDH","President and CEO, director"],["WALL JOHN M","Sr. VP & CFO"],["GAVRIELOV MOSHE","Director"]],"rows":[["S",0,2000,634000,"2026-11-16","2026-11-16","0000813672-26-000130","2026-11-17",1],["S",1,750,251564.18,"2026-11-10","2026-11-11","0000813672-26-000127","2026-11-12",0],["S",2,2401,813939,"2026-11-09","2026-11-09","0000813672-26-000124","2026-11-10",1],["S",0,2000,648260,"2026-10-15","2026-10-15","0000813672-26-000112","2026-10-16",1],["S",3,1250,437589.88,"2026-10-01","2026-10-01","0000813672-26-000109","2026-10-05",1],["S",0,2000,554240,"2026-09-15","2026-09-15","0000813672-26-000100","2026-09-17",1],["S",4,180,51391.97,"2026-09-10","2026-09-10","0000813672-26-000099","2026-09-14",1],["S",2,280,94920,"2026-08-26","2026-08-26","0000813672-26-000098","2026-08-27",1],["S",3,1250,401094.55,"2026-08-25","2026-08-25","0000813672-26-000097","2026-08-27",1],["S",5,4732,1488166.68,"2026-08-21","2026-08-21","0000813672-26-000095","2026-08-25",1],["S",0,2000,646640,"2026-08-17","2026-08-17","0000813672-26-000093","2026-08-19",1],["S",5,4500,1527555.18,"2026-07-22","2026-07-22","0000813672-26-000085","2026-07-23",1],["S",0,2000,766720,"2026-07-15","2026-07-15","0000813672-26-000084","2026-07-17",1],["S",5,4500,1731969.98,"2026-06-22","2026-06-22","0000813672-26-000082","2026-06-24",1],["S",0,2000,782000