0df9d0"},"PTC.q.risk.1":{"c":"PTC","kind":"risk","quote":"The announcement and pendency of the proposed Merger could adversely affect our business, operations and relationships with employees, customers, and other business partners.","source":"PTC-0001193125-26-470217","section":"Risk factors","date":"2026-11-20","proof":"308be52492b0e508551772db318a0dba04b05a79048c7d666e3050ad7525613d"},"PTC.q.risk.2":{"c":"PTC","kind":"risk","quote":"The Merger Agreement subjects us to restrictions on the conduct of our business prior to closing, which could adversely affect our operations or our ability to pursue business opportunities.","source":"PTC-0001193125-26-470217","section":"Risk factors","date":"2026-11-20","proof":"76228f8f2c8fe6c9738422f392a1ac5bf89c7c56c9d6d98b84305d80edff2bc4"},"PTC.q.risk.3":{"c":"PTC","kind":"risk","quote":"The proposed Merger could result in additional costs, litigation and other adverse consequences.","source":"PTC-0001193125-26-470217","section":"Risk factors","date":"2026-11-20","proof":"5a03be056145ab674aecdf3652f254c3cbcda6898c5c8bb69f9cff3ca4f0aebc"},"PTC.q.risk.4":{"c":"PTC","kind":"risk","quote":"The Merger Agreement contains provisions that limit our ability to pursue alternative transactions to the Merger which could discourage a potential competing acquirer from making an alternative acquisition proposal.","source":"PTC-0001193125-26-470217","section":"Risk factors","date":"2026-11-20","proof":"bae8fa135a695841bb31c1d8f9eb54fb166051c6d314280eb212943edbd9e419"}},"sources":{"PTC-0001193125-25-291326":{"kind":"prior-annual-report","by":"PTC","form":"10-K","period":"2025-09-30","date":"2025-11-21","accn":"0001193125-25-291326","title":"PTC 10-K for the fiscal year ended 2025-09-30","url":"https://www.sec.gov/Archives/edgar/data/857005/000119312525291326/ptc-20250930.htm","sha":"a90c1fe5b47d46092a1eb316989bab6e49015fdb64e6e1cbb36ebb99702c5c1e"}}}