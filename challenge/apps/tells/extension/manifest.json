{
  "manifest_version": 3,
  "name": "Tells",
  "short_name": "Tells",
  "version": "1.0.0",
  "description": "See the tells of AI in a LinkedIn or X post, a selection, a page or a picture. Evidence and a likelihood, not a verdict.",
  "homepage_url": "https://challenge.strongtechnicalconsulting.com/tells/",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Tells",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "permissions": ["contextMenus", "storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://media.licdn.com/*",
    "https://pbs.twimg.com/*",
    "https://challenge.strongtechnicalconsulting.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*", "https://x.com/*", "https://twitter.com/*"],
      "js": ["tells-core.js", "ui.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
